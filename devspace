#!/usr/bin/env bash

layout="${1:-side}"

workspace_width=$(xprop -root _NET_WORKAREA | cut -d= -f2 | cut -d, -f3)
workspace_height=$(xprop -root _NET_WORKAREA | cut -d= -f2 | cut -d, -f4)
half_width=$(( workspace_width / 2 ))
half_height=$(( workspace_height / 2 ))
workspace_x=$(xprop -root _NET_WORKAREA | cut -d= -f2 | cut -d, -f1)
workspace_y=$(xprop -root _NET_WORKAREA | cut -d= -f2 | cut -d, -f2)
firefox_target_y=$(( workspace_y + half_height ))
terminator_target_y=$workspace_y

terminator_target_x=$workspace_x
firefox_target_x=$(( workspace_x + half_width ))

echo "Workspace width: $workspace_width | Half: $half_width | Firefox target X: $firefox_target_x"

terminator_id=$(
    for id in $(xdotool search --onlyvisible --class terminator); do
        if xprop -id "$id" _MOTIF_WM_HINTS 2>/dev/null |
           grep -q '= 0x2, 0x0, 0x0'; then
            echo "$id"
            break
        fi
    done
)

if [[ -z "$terminator_id" ]]; then
    echo "Terminator window not found"
    terminator --borderless >/dev/null 2>&1 &
    terminator_id=$(
    for ((attempt=0; attempt<20; attempt++)); do
        for id in $(xdotool search --onlyvisible --class terminator); do
            if xprop -id "$id" _MOTIF_WM_HINTS 2>/dev/null |
               grep -q '= 0x2, 0x0, 0x0'; then
                echo "$id"
                exit 0
            fi
        done
        sleep 0.5
    done
)
    if [[ -z "$terminator_id" ]]; then
        echo "Error: Terminator failed to open a window." >&2
        exit 1
    fi
fi

firefox_id=$(xdotool search --onlyvisible --class 'firefox-esr' | head -n 1)

if [[ -z "$firefox_id" ]]; then
    echo "Firefox window not found"
    firefox-esr >/dev/null 2>&1 &
    firefox_id=$(timeout 10s xdotool search --sync --onlyvisible --class 'firefox-esr' | head -n 1)

    if [[ -z "$firefox_id" ]]; then
        echo "Error: Firefox failed to open a window." >&2
        exit 1
    fi
fi
if xprop -id "$firefox_id" _NET_WM_STATE | grep -q '_NET_WM_STATE_MAXIMIZED_HORZ'; then
    wmctrl -ir "$firefox_id" -b remove,maximized_horz
    sleep 0.2
fi
IFS=', ' read -r left right top bottom <<< "$(xprop -id "$firefox_id" _GTK_FRAME_EXTENTS | cut -d= -f2)"
firefox_frame_width=$(( left + right ))
firefox_frame_height=$(( top + bottom ))
firefox_frame_top=$top
firefox_target_height=$(( half_height + firefox_frame_height ))
firefox_target_width=$(( workspace_width + firefox_frame_width ))
firefox_stacked_x=$(( workspace_x - firefox_frame_width / 2 ))
echo "Firefox frame extents: left=$left right=$right top=$top bottom=$bottom"
echo "Terminator window ID: $terminator_id"
terminator_base_width=$(xprop -id "$terminator_id" WM_NORMAL_HINTS | awk '/base size/ {print $(NF-2)}')
terminator_width_increment=$(xprop -id "$terminator_id" WM_NORMAL_HINTS | awk '/resize increment/ {print $(NF-2)}')
terminator_base_height=$(xprop -id "$terminator_id" WM_NORMAL_HINTS | awk '/base size/ {print $NF}')
terminator_height_increment=$(xprop -id "$terminator_id" WM_NORMAL_HINTS | awk '/resize increment/ {print $NF}')
if [[ "$terminator_base_height" =~ ^[0-9]+$ && "$terminator_height_increment" =~ ^[1-9][0-9]*$ ]]; then
    terminator_target_height=$(( terminator_base_height + ((half_height - terminator_base_height) / terminator_height_increment) * terminator_height_increment ))
else
    terminator_target_height=$half_height
fi

if [[ "$terminator_base_width" =~ ^[0-9]+$ && "$terminator_width_increment" =~ ^[1-9][0-9]*$ ]]; then
    terminator_target_width=$(( terminator_base_width + ((workspace_width - terminator_base_width) / terminator_width_increment) * terminator_width_increment ))
    terminator_side_width=$(( terminator_base_width + ((half_width - terminator_base_width) / terminator_width_increment) * terminator_width_increment ))
else
    terminator_target_width=$workspace_width
    terminator_side_width=$half_width
fi

echo "Firefox window ID: $firefox_id"
if [[ "$layout" == "toggle" ]]; then
    terminator_geometry=$(xdotool getwindowgeometry --shell "$terminator_id")
    terminator_x=$(grep '^X=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_y=$(grep '^Y=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_width=$(grep '^WIDTH=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_height=$(grep '^HEIGHT=' <<< "$terminator_geometry" | cut -d= -f2)
    if (( terminator_x == terminator_target_x && terminator_y == terminator_target_y &&
          terminator_width == terminator_target_width &&
          terminator_height == terminator_target_height )); then
        layout="side"
    else
        layout="stacked"
    fi
fi
if [[ "$layout" == "stacked" ]]; then
    echo "Stacked layout selected"
    terminator_geometry=$(xdotool getwindowgeometry --shell "$terminator_id")
    terminator_x=$(grep '^X=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_y=$(grep '^Y=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_width=$(grep '^WIDTH=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_height=$(grep '^HEIGHT=' <<< "$terminator_geometry" | cut -d= -f2)
    if (( terminator_x == terminator_target_x && terminator_y == terminator_target_y &&
          terminator_width == terminator_target_width && terminator_height == terminator_target_height )); then
        echo "Terminator is already correctly positioned!"
    else
        echo "Terminator needs repositioning."
        wmctrl -ir "$terminator_id" -b remove,maximized_vert
        wmctrl -ir "$terminator_id" -e 0,"$terminator_target_x","$terminator_target_y",-1,-1
        wmctrl -ir "$terminator_id" -e 0,-1,-1,-1,"$terminator_target_height"
        wmctrl -ir "$terminator_id" -e 0,-1,-1,"$terminator_target_width",-1
    fi
    terminator_geometry=$(xdotool getwindowgeometry --shell "$terminator_id")
    terminator_y=$(grep '^Y=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_height=$(grep '^HEIGHT=' <<< "$terminator_geometry" | cut -d= -f2)
    firefox_stacked_y=$(( terminator_y + terminator_height - firefox_frame_top ))
    firefox_geometry=$(xdotool getwindowgeometry --shell "$firefox_id")
    firefox_x=$(grep '^X=' <<< "$firefox_geometry" | cut -d= -f2)
    firefox_y=$(grep '^Y=' <<< "$firefox_geometry" | cut -d= -f2)
    firefox_width=$(grep '^WIDTH=' <<< "$firefox_geometry" | cut -d= -f2)
    firefox_height=$(grep '^HEIGHT=' <<< "$firefox_geometry" | cut -d= -f2)
    if (( firefox_x == firefox_stacked_x && firefox_y == firefox_stacked_y &&
      firefox_width == firefox_target_width && firefox_height == firefox_target_height )); then
        echo "Firefox is already correctly positioned!"
    else
        echo "Firefox needs repositioning."
        wmctrl -ir "$firefox_id" -b remove,maximized_vert
        wmctrl -ir "$firefox_id" -e 0,"$firefox_stacked_x","$firefox_stacked_y","$firefox_target_width","$firefox_target_height"
    fi

else
    echo "Side-by-side layout selected"

    terminator_geometry=$(xdotool getwindowgeometry --shell "$terminator_id")
    terminator_x=$(grep '^X=' <<< "$terminator_geometry" | cut -d= -f2)
    terminator_width=$(grep '^WIDTH=' <<< "$terminator_geometry" | cut -d= -f2)

    if (( terminator_x == terminator_target_x && terminator_width == terminator_side_width )) &&
       xprop -id "$terminator_id" _NET_WM_STATE |
       grep -q '_NET_WM_STATE_MAXIMIZED_VERT'; then
        echo "Terminator position and width are correct"
    else
        wmctrl -ir "$terminator_id" -b remove,maximized_vert
        wmctrl -ir "$terminator_id" -e 0,"$terminator_target_x",-1,"$terminator_side_width",-1
        wmctrl -ir "$terminator_id" -b add,maximized_vert
        terminator_geometry=$(xdotool getwindowgeometry --shell "$terminator_id")
        terminator_x=$(grep '^X=' <<< "$terminator_geometry" | cut -d= -f2)
        terminator_width=$(grep '^WIDTH=' <<< "$terminator_geometry" | cut -d= -f2)
        if (( terminator_x != terminator_target_x || terminator_width != terminator_side_width )); then
            echo "Warning: Terminator did not reach its target position or width." >&2
        fi
    fi

    firefox_x=$(xdotool getwindowgeometry --shell "$firefox_id" | grep '^X=' | cut -d= -f2)

    firefox_width=$(xdotool getwindowgeometry --shell "$firefox_id" | grep '^WIDTH=' | cut -d= -f2)

    if (( firefox_x + left == firefox_target_x && firefox_width - firefox_frame_width == half_width )) &&
       xprop -id "$firefox_id" _NET_WM_STATE |
       grep -q '_NET_WM_STATE_MAXIMIZED_VERT'; then
        echo "Firefox is already vertically maximized"
    else
        xdotool windowactivate --sync "$firefox_id"
        xdotool key --clearmodifiers super+Right
    fi
fi
